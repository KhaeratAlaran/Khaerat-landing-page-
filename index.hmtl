<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reel Results — The Complete Video Editing Programme</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --cream: #F5F0E8;
    --beige: #E8DFD0;
    --warm-tan: #C9B99A;
    --dark-brown: #2C1A0E;
    --mid-brown: #5C3D2E;
    --accent: #C4622D;
    --accent-light: #E8845A;
    --soft-white: #FAF7F2;
    --text-muted: #8A7060;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background-color: var(--cream);
    color: var(--dark-brown);
    font-family: 'DM Sans', sans-serif;
    overflow-x: hidden;
  }

  /* ── NAV ── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    padding: 20px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(245, 240, 232, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(201, 185, 154, 0.3);
  }

  .nav-logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--dark-brown);
    letter-spacing: 0.02em;
  }

  .nav-cta {
    background: var(--accent);
    color: white;
    padding: 10px 24px;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    letter-spacing: 0.02em;
  }

  .nav-cta:hover {
    background: var(--mid-brown);
    transform: translateY(-1px);
  }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 120px 80px 80px;
    gap: 60px;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -200px; right: -200px;
    width: 600px; height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(196, 98, 45, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    bottom: -100px; left: -100px;
    width: 400px; height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(201, 185, 154, 0.3) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-tag {
    display: inline-block;
    background: var(--beige);
    border: 1px solid var(--warm-tan);
    color: var(--mid-brown);
    padding: 6px 16px;
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 24px;
    animation: fadeUp 0.8s ease forwards;
  }

  .hero-headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.8rem, 5vw, 4.2rem);
    font-weight: 900;
    line-height: 1.1;
    color: var(--dark-brown);
    margin-bottom: 24px;
    animation: fadeUp 0.8s ease 0.1s both;
  }

  .hero-headline em {
    font-style: italic;
    color: var(--accent);
  }

  .hero-sub {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--mid-brown);
    max-width: 480px;
    margin-bottom: 40px;
    font-weight: 300;
    animation: fadeUp 0.8s ease 0.2s both;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
    animation: fadeUp 0.8s ease 0.3s both;
  }

  .btn-primary {
    background: var(--accent);
    color: white;
    padding: 16px 36px;
    border-radius: 100px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 8px 30px rgba(196, 98, 45, 0.3);
    letter-spacing: 0.01em;
  }

  .btn-primary:hover {
    background: var(--mid-brown);
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(196, 98, 45, 0.4);
  }

  .btn-ghost {
    color: var(--mid-brown);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: color 0.3s;
  }

  .btn-ghost:hover { color: var(--accent); }

  /* hero visual card */
  .hero-visual {
    position: relative;
    animation: fadeUp 0.8s ease 0.4s both;
  }

  .hero-card {
    background: var(--soft-white);
    border-radius: 24px;
    padding: 48px 40px;
    border: 1px solid var(--beige);
    box-shadow: 0 20px 60px rgba(44, 26, 14, 0.1);
    position: relative;
    overflow: hidden;
  }

  .hero-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--accent), var(--accent-light));
  }

  .pain-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 32px;
  }

  .pain-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.95rem;
    color: var(--mid-brown);
    line-height: 1.5;
  }

  .pain-icon {
    width: 22px; height: 22px;
    background: rgba(196, 98, 45, 0.12);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
    font-size: 0.7rem;
  }

  .card-divider {
    height: 1px;
    background: var(--beige);
    margin: 24px 0;
  }

  .card-result {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    color: var(--dark-brown);
    font-style: italic;
    text-align: center;
  }

  /* floating badge */
  .float-badge {
    position: absolute;
    bottom: -20px; right: -20px;
    background: var(--accent);
    color: white;
    border-radius: 16px;
    padding: 16px 20px;
    text-align: center;
    box-shadow: 0 8px 24px rgba(196, 98, 45, 0.4);
  }

  .float-badge .num {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    font-weight: 900;
    line-height: 1;
  }

  .float-badge .label {
    font-size: 0.7rem;
    font-weight: 500;
    opacity: 0.9;
    letter-spacing: 0.05em;
  }

  /* ── PAIN SECTION ── */
  .pain-section {
    background: var(--dark-brown);
    padding: 100px 80px;
    position: relative;
    overflow: hidden;
  }

  .pain-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23C9B99A' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    pointer-events: none;
  }

  .section-tag {
    display: inline-block;
    border: 1px solid rgba(201, 185, 154, 0.4);
    color: var(--warm-tan);
    padding: 6px 16px;
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .section-tag.dark { border-color: var(--warm-tan); color: var(--mid-brown); }

  .pain-headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: var(--soft-white);
    margin-bottom: 60px;
    max-width: 600px;
    line-height: 1.2;
  }

  .pain-headline em {
    font-style: italic;
    color: var(--accent-light);
  }

  .pain-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .pain-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(201, 185, 154, 0.15);
    border-radius: 20px;
    padding: 32px 28px;
    transition: all 0.3s ease;
  }

  .pain-card:hover {
    background: rgba(255,255,255,0.07);
    transform: translateY(-4px);
    border-color: rgba(196, 98, 45, 0.4);
  }

  .pain-card-icon {
    font-size: 1.8rem;
    margin-bottom: 16px;
  }

  .pain-card h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    color: var(--soft-white);
    margin-bottom: 10px;
    font-weight: 700;
  }

  .pain-card p {
    font-size: 0.88rem;
    color: rgba(201, 185, 154, 0.8);
    line-height: 1.6;
    font-weight: 300;
  }

  /* ── WHAT'S INSIDE ── */
  .inside-section {
    padding: 100px 80px;
    background: var(--soft-white);
  }

  .inside-header {
    text-align: center;
    margin-bottom: 70px;
  }

  .inside-headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: var(--dark-brown);
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .inside-sub {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .modules-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    max-width: 900px;
    margin: 0 auto;
  }

  .module-card {
    background: var(--cream);
    border: 1px solid var(--beige);
    border-radius: 20px;
    padding: 32px 28px;
    display: flex;
    gap: 20px;
    align-items: flex-start;
    transition: all 0.3s ease;
  }

  .module-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(44, 26, 14, 0.1);
    border-color: var(--accent);
  }

  .module-num {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 900;
    color: var(--accent);
    opacity: 0.3;
    line-height: 1;
    flex-shrink: 0;
  }

  .module-content h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--dark-brown);
    margin-bottom: 8px;
  }

  .module-content p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* bonus */
  .bonus-strip {
    margin-top: 40px;
    background: linear-gradient(135deg, var(--accent) 0%, var(--mid-brown) 100%);
    border-radius: 20px;
    padding: 32px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    max-width: 900px;
    margin: 40px auto 0;
  }

  .bonus-text h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    color: white;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .bonus-text p {
    font-size: 0.88rem;
    color: rgba(255,255,255,0.8);
  }

  .bonus-badge {
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.3);
    color: white;
    padding: 8px 20px;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    letter-spacing: 0.05em;
  }

  /* ── FOR WHO ── */
  .who-section {
    padding: 100px 80px;
    background: var(--cream);
  }

  .who-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
    max-width: 1000px;
    margin: 0 auto;
  }

  .who-headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 900;
    color: var(--dark-brown);
    line-height: 1.2;
    margin-bottom: 20px;
  }

  .who-headline em {
    font-style: italic;
    color: var(--accent);
  }

  .who-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .who-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .who-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 20px;
    background: var(--soft-white);
    border-radius: 14px;
    border: 1px solid var(--beige);
    font-size: 0.92rem;
    color: var(--mid-brown);
    line-height: 1.5;
    transition: all 0.3s;
  }

  .who-item:hover {
    border-color: var(--accent);
    background: white;
  }

  .who-check {
    width: 22px; height: 22px;
    background: var(--accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: white;
    font-size: 0.7rem;
    margin-top: 1px;
  }

  /* ── TESTIMONIAL ── */
  .social-proof {
    padding: 80px;
    background: var(--beige);
    text-align: center;
  }

  .proof-quote {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-style: italic;
    color: var(--dark-brown);
    max-width: 700px;
    margin: 0 auto 24px;
    line-height: 1.5;
  }

  .proof-author {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* ── PRICING ── */
  .pricing-section {
    padding: 100px 80px;
    background: var(--soft-white);
    text-align: center;
  }

  .pricing-headline {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: var(--dark-brown);
    margin-bottom: 16px;
  }

  .pricing-sub {
    color: var(--text-muted);
    margin-bottom: 60px;
    font-size: 1rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .pricing-cards {
    display: flex;
    gap: 24px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .price-card {
    background: var(--cream);
    border: 1px solid var(--beige);
    border-radius: 24px;
    padding: 48px 40px;
    width: 320px;
    position: relative;
    transition: all 0.3s ease;
  }

  .price-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 60px rgba(44, 26, 14, 0.12);
  }

  .price-card.featured {
    background: var(--dark-brown);
    border-color: var(--accent);
    transform: scale(1.04);
  }

  .price-card.featured:hover {
    transform: scale(1.04) translateY(-6px);
  }

  .popular-badge {
    position: absolute;
    top: -14px; left: 50%; transform: translateX(-50%);
    background: var(--accent);
    color: white;
    padding: 5px 18px;
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .price-tier {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .price-card.featured .price-tier { color: var(--warm-tan); }

  .price-amount {
    font-family: 'Playfair Display', serif;
    font-size: 2.8rem;
    font-weight: 900;
    color: var(--dark-brown);
    margin-bottom: 8px;
    line-height: 1;
  }

  .price-card.featured .price-amount { color: var(--soft-white); }

  .price-note {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 32px;
  }

  .price-card.featured .price-note { color: var(--warm-tan); }

  .price-features {
    list-style: none;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 36px;
  }

  .price-feature {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 0.88rem;
    color: var(--mid-brown);
    line-height: 1.5;
  }

  .price-card.featured .price-feature { color: rgba(201, 185, 154, 0.9); }

  .feat-check {
    color: var(--accent);
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .price-card.featured .feat-check { color: var(--accent-light); }

  .btn-enrol {
    display: block;
    text-align: center;
    padding: 14px 32px;
    border-radius: 100px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
    letter-spacing: 0.01em;
  }

  .btn-enrol-outline {
    border: 2px solid var(--accent);
    color: var(--accent);
  }

  .btn-enrol-outline:hover {
    background: var(--accent);
    color: white;
  }

  .btn-enrol-solid {
    background: var(--accent);
    color: white;
    box-shadow: 0 8px 24px rgba(196, 98, 45, 0.35);
  }

  .btn-enrol-solid:hover {
    background: var(--accent-light);
    box-shadow: 0 12px 32px rgba(196, 98, 45, 0.5);
    transform: translateY(-1px);
  }

  /* ── FAQ ── */
  .faq-section {
    padding: 100px 80px;
    background: var(--cream);
    max-width: 800px;
    margin: 0 auto;
  }

  .faq-headline {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 900;
    color: var(--dark-brown);
    margin-bottom: 48px;
    text-align: center;
  }

  .faq-item {
    border-bottom: 1px solid var(--beige);
    padding: 24px 0;
  }

  .faq-q {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--dark-brown);
    margin-bottom: 10px;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-a {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.7;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
  }

  .faq-item.open .faq-a { max-height: 200px; }

  .faq-arrow {
    font-size: 0.8rem;
    transition: transform 0.3s;
    color: var(--accent);
  }

  .faq-item.open .faq-arrow { transform: rotate(180deg); }

  /* ── FOOTER CTA ── */
  .footer-cta {
    background: var(--dark-brown);
    padding: 100px 80px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .footer-cta::before {
    content: '';
    position: absolute;
    top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 600px; height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(196, 98, 45, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .footer-cta h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    color: var(--soft-white);
    margin-bottom: 20px;
    line-height: 1.2;
  }

  .footer-cta h2 em {
    font-style: italic;
    color: var(--accent-light);
  }

  .footer-cta p {
    font-size: 1rem;
    color: var(--warm-tan);
    margin-bottom: 40px;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }

  .footer-bottom {
    background: var(--dark-brown);
    border-top: 1px solid rgba(201, 185, 154, 0.15);
    padding: 24px 80px;
    text-align: center;
    font-size: 0.8rem;
    color: rgba(201, 185, 154, 0.5);
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    nav { padding: 16px 24px; }
    .hero { grid-template-columns: 1fr; padding: 100px 24px 60px; gap: 40px; }
    .pain-section, .inside-section, .who-section, .pricing-section, .footer-cta { padding: 70px 24px; }
    .social-proof { padding: 60px 24px; }
    .faq-section { padding: 70px 24px; }
    .footer-bottom { padding: 20px 24px; }
    .pain-grid { grid-template-columns: 1fr; }
    .modules-grid { grid-template-columns: 1fr; }
    .who-grid { grid-template-columns: 1fr; gap: 40px; }
